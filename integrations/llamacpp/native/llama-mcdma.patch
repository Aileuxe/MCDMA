+    auto & ranges = device->mcdma_ranges;
+    for (auto it = ranges.begin(); it != ranges.end();) {
+        auto & range = *it;
+        GGML_ASSERT(range->state == vk_dma_state::planned || range->state == vk_dma_state::reacquire);
+        if (range->state == vk_dma_state::reacquire) {
+            vk_buffer buffer = range->buffer.lock();
+            GGML_ASSERT(buffer);
+            ggml_vk_dma_record_barrier(commands, buffer, range->offset, range->size, false);
