index 000000000..ffed265ed
--- /dev/null
+++ b/ggml/src/ggml-rpc/mcdma-rdma.cpp
@@ -0,0 +1,191 @@
+#include "mcdma-rdma.h"
+#include "ggml-impl.h"
+#include <infiniband/verbs.h>
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <mutex>
+#include <thread>
+
+static void require(bool ok, const char * what) {
+    if (!ok) GGML_ABORT("MCDMA: %s failed (errno=%d); no staging fallback", what, errno);
+}
+static unsigned env_uint(const char * name, unsigned fallback, unsigned max) {
+    const char * s = std::getenv(name);
+    if (!s) return fallback;
+    char * end = nullptr;
+    errno = 0;
+    unsigned long v = std::strtoul(s, &end, 10);
+    require(!errno && end != s && *end == 0 && v <= max, name);
+    return (unsigned)v;
+}
+struct mcdma_channel::impl {
+    ibv_context * context = nullptr;
+    ibv_pd * pd = nullptr;
+    ibv_cq * cq = nullptr;
+    ibv_qp * qp = nullptr;
+    mcdma_caps local = {}, peer = {};
+    unsigned port = 1, gid_index = 0;
+    uint64_t serial = 0, transfers = 0, bytes = 0;
+    std::atomic<size_t> registrations{0};
+    std::mutex operation_mutex;
+    bool connected = false;
+};
+struct mcdma_region::impl {
+    ibv_mr * mr = nullptr;
+    uint64_t address = 0;
+    size_t length = 0;
+    std::atomic<size_t> * registrations = nullptr;
+};
+mcdma_region::mcdma_region(std::unique_ptr<impl> value) : p(std::move(value)) {}
+mcdma_region::~mcdma_region() {
+    if (p->mr) {
+        require(ibv_dereg_mr(p->mr) == 0, "MR deregistration");
+        --*p->registrations;
+    }
+}
+uint64_t mcdma_region::address() const { return p->address; }
+uint32_t mcdma_region::rkey() const { return p->mr->rkey; }
+size_t mcdma_region::size() const { return p->length; }
+
+mcdma_channel::mcdma_channel() : p(new impl) {
+    const char * dev = std::getenv("MCDMA_RDMA_DEV");
+    require(dev && *dev && std::getenv("MCDMA_RDMA_GID"), "explicit RDMA device/GID selection");
+    p->port = env_uint("MCDMA_RDMA_PORT", 1, 255);
+    p->gid_index = env_uint("MCDMA_RDMA_GID", 0, 255);
+    require(p->port > 0, "nonzero RDMA port");
+    int count = 0;
+    ibv_device ** devices = ibv_get_device_list(&count);
+    require(devices, "device enumeration");
+    for (int i = 0; i < count; ++i) {
+        if (!std::strcmp(ibv_get_device_name(devices[i]), dev)) p->context = ibv_open_device(devices[i]);
+    }
+    ibv_free_device_list(devices);
+    require(p->context, "selected device open");
+    ibv_port_attr port = {};
+    require(ibv_query_port(p->context, p->port, &port) == 0 && port.state == IBV_PORT_ACTIVE, "active RDMA port");
+    require(p->gid_index < (unsigned)port.gid_tbl_len, "GID index bounds");
+    ibv_gid gid = {};
+    require(ibv_query_gid(p->context, p->port, p->gid_index, &gid) == 0, "GID query");
+    std::memcpy(p->local.gid, gid.raw, 16);
+    bool nonzero = false;
+    for (auto c : p->local.gid) nonzero |= c != 0;
+    require(nonzero, "nonzero GID");
+    p->local.lid = port.lid;
+    p->local.mtu = std::min((unsigned)port.active_mtu, (unsigned)IBV_MTU_4096);
+    p->local.version = 1;
+    p->pd = ibv_alloc_pd(p->context);
+    require(p->pd, "protection domain");
+    p->cq = ibv_create_cq(p->context, 16, nullptr, nullptr, 0);
+    require(p->cq, "completion queue");
+    ibv_qp_init_attr attr = {};
+    attr.send_cq = p->cq; attr.recv_cq = p->cq; attr.qp_type = IBV_QPT_RC;
+    attr.cap.max_send_wr = 8; attr.cap.max_recv_wr = 1;
+    attr.cap.max_send_sge = 1; attr.cap.max_recv_sge = 1;
+    p->qp = ibv_create_qp(p->pd, &attr);
+    require(p->qp, "RC queue pair");
+    p->local.qpn = p->qp->qp_num;
+    p->local.psn = std::random_device{}() & 0xffffff;
+    ibv_qp_attr init = {};
+    init.qp_state = IBV_QPS_INIT; init.port_num = p->port; init.pkey_index = 0;
+    init.qp_access_flags = IBV_ACCESS_REMOTE_READ | IBV_ACCESS_REMOTE_WRITE;
+    require(ibv_modify_qp(p->qp, &init, IBV_QP_STATE | IBV_QP_PORT | IBV_QP_PKEY_INDEX | IBV_QP_ACCESS_FLAGS) == 0, "QP INIT");
+    GGML_LOG_INFO("MCDMA native tensor channel created; payload staging disabled\n");
+}
+mcdma_caps mcdma_channel::caps() const { return p->local; }
+void mcdma_channel::connect(const mcdma_caps & peer) {
+    require(peer.version == 1 && peer.reserved == 0 && peer.qpn && peer.qpn <= 0xffffff && peer.psn <= 0xffffff && peer.mtu >= IBV_MTU_256 && peer.mtu <= IBV_MTU_4096, "peer capabilities");
+    if (p->connected) {
+        require(std::memcmp(&peer, &p->peer, sizeof(peer)) == 0, "unchanged peer identity");
+        return;
+    }
+    ibv_qp_attr attr = {};
+    attr.qp_state = IBV_QPS_RTR;
+    attr.path_mtu = (ibv_mtu)std::min(p->local.mtu, peer.mtu);
+    attr.dest_qp_num = peer.qpn; attr.rq_psn = peer.psn;
+    attr.max_dest_rd_atomic = 1; attr.min_rnr_timer = 12;
+    attr.ah_attr.is_global = 1; attr.ah_attr.port_num = p->port;
+    attr.ah_attr.dlid = peer.lid; attr.ah_attr.grh.sgid_index = p->gid_index;
+    attr.ah_attr.grh.hop_limit = 1;
+    std::memcpy(attr.ah_attr.grh.dgid.raw, peer.gid, 16);
+    require(ibv_modify_qp(p->qp, &attr, IBV_QP_STATE | IBV_QP_AV | IBV_QP_PATH_MTU | IBV_QP_DEST_QPN | IBV_QP_RQ_PSN | IBV_QP_MAX_DEST_RD_ATOMIC | IBV_QP_MIN_RNR_TIMER) == 0, "QP RTR");
+    attr = {};
+    attr.qp_state = IBV_QPS_RTS; attr.sq_psn = p->local.psn;
+    attr.timeout = 16; attr.retry_cnt = 5; attr.rnr_retry = 5; attr.max_rd_atomic = 1;
+    require(ibv_modify_qp(p->qp, &attr, IBV_QP_STATE | IBV_QP_SQ_PSN | IBV_QP_TIMEOUT | IBV_QP_RETRY_CNT | IBV_QP_RNR_RETRY | IBV_QP_MAX_QP_RD_ATOMIC) == 0, "QP RTS");
+    p->peer = peer; p->connected = true;
+}
+std::unique_ptr<mcdma_region> mcdma_channel::register_span(const ggml_backend_dma_span & span, bool remote_write) {
+    return register_flags(span, IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_READ | (remote_write ? IBV_ACCESS_REMOTE_WRITE : 0));
+}
+std::unique_ptr<mcdma_region> mcdma_channel::register_read_only_span(const ggml_backend_dma_span & span) {
+    return register_flags(span, 0);
+}
+std::unique_ptr<mcdma_region> mcdma_channel::register_flags(const ggml_backend_dma_span & span, int access) {
+    require(p->qp && span.host_ptr && span.size && span.size <= SIZE_MAX, "registration span");
+    auto region = std::unique_ptr<mcdma_region::impl>(new mcdma_region::impl);
+    if (span.fd >= 0) {
+        require(span.fd_offset <= UINT64_MAX - span.size, "DMA-BUF range");
+        region->address = span.fd_offset;
+        region->mr = ibv_reg_dmabuf_mr(p->pd, span.fd_offset, span.size, region->address, span.fd, access);
+    } else {
+        require(span.fd == -1 && span.fd_offset == 0, "host span metadata");
+        region->address = (uintptr_t)span.host_ptr;
+        region->mr = ibv_reg_mr(p->pd, span.host_ptr, span.size, access);
+    }
+    require(region->mr, "tensor memory registration");
+    region->length = span.size;
+    region->registrations = &p->registrations;
+    ++p->registrations;
+    return std::unique_ptr<mcdma_region>(new mcdma_region(std::move(region)));
+}
+void mcdma_channel::transfer(mcdma_region & local, uint64_t remote_address, uint32_t remote_rkey, size_t bytes, bool write) {
+    transfer_at(local, 0, remote_address, remote_rkey, bytes, write);
+}
+void mcdma_channel::transfer_at(mcdma_region & local, size_t local_offset, uint64_t remote_address, uint32_t remote_rkey, size_t bytes, bool write) {
+    std::lock_guard<std::mutex> guard(p->operation_mutex);
+    require(p->connected && p->qp && bytes && local_offset <= local.size() && bytes <= local.size() - local_offset && remote_address <= UINT64_MAX - bytes, "transfer bounds/state");
+    size_t offset = 0;
+    while (offset < bytes) {
+        const size_t length = std::min(bytes - offset, size_t(4 * 1024 * 1024));
+        ibv_sge sge = {};
+        sge.addr = local.address() + local_offset + offset; sge.length = length; sge.lkey = local.p->mr->lkey;
+        ibv_send_wr wr = {}, * bad = nullptr;
+        wr.wr_id = ++p->serial; wr.sg_list = &sge; wr.num_sge = 1;
+        wr.opcode = write ? IBV_WR_RDMA_WRITE : IBV_WR_RDMA_READ;
+        wr.send_flags = IBV_SEND_SIGNALED;
+        wr.wr.rdma.remote_addr = remote_address + offset; wr.wr.rdma.rkey = remote_rkey;
+        require(ibv_post_send(p->qp, &wr, &bad) == 0, "post tensor transfer");
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+        ibv_wc wc = {};
+        for (;;) {
+            int count = ibv_poll_cq(p->cq, 1, &wc);
+            require(count >= 0, "completion poll");
+            if (count) break;
+            require(std::chrono::steady_clock::now() < deadline, "tensor transfer deadline");
+        }
+        require(wc.status == IBV_WC_SUCCESS && wc.wr_id == wr.wr_id && wc.opcode == (write ? IBV_WC_RDMA_WRITE : IBV_WC_RDMA_READ), "tensor completion status/identity");
+        offset += length;
+    }
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    ++p->transfers; p->bytes += bytes;
+}
+void mcdma_channel::stop() {
+    if (p->qp) {
+        require(ibv_destroy_qp(p->qp) == 0, "QP teardown");
+        p->qp = nullptr;
+    }
+    p->connected = false;
+}
+mcdma_channel::~mcdma_channel() {
+    stop();
+    require(p->registrations == 0, "all tensor MRs released before channel destruction");
+    if (p->cq) require(ibv_destroy_cq(p->cq) == 0, "CQ teardown");
+    if (p->pd) require(ibv_dealloc_pd(p->pd) == 0, "PD teardown");
+    if (p->context) require(ibv_close_device(p->context) == 0, "device teardown");
+    GGML_LOG_INFO("MCDMA native transfers=%llu bytes=%llu payload_staging_bytes=0\n", (unsigned long long)p->transfers, (unsigned long long)p->bytes);
+}
