+    vk_device device = buffer->device;
+    std::lock_guard<std::recursive_mutex> guard(device->mutex);
+    GGML_ASSERT(offset <= buffer->size && size <= buffer->size - offset);
+    vk_context commands;
+    auto & ranges = device->mcdma_ranges;
+    for (auto it = ranges.begin(); it != ranges.end();) {
+        const auto & range = *it;
+        if (range->buffer.lock() != buffer || range->state == vk_dma_state::planned ||
+            !ggml_vk_dma_overlap(offset, size, range->offset, range->size)) {
