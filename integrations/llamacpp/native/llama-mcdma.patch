+#pragma once
+#include "ggml-backend-impl.h"
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+
+struct mcdma_caps {
+    uint8_t gid[16];
+    uint32_t qpn, psn, mtu;
+    uint16_t lid, reserved;
+    uint32_t version;
+};
+
+class __attribute__((visibility("default"))) mcdma_region {
+public:
+    ~mcdma_region();
+    uint64_t address() const;
+    uint32_t rkey() const;
+    size_t size() const;
+private:
+    friend class mcdma_channel;
+    struct impl;
+    explicit mcdma_region(std::unique_ptr<impl>);
+    std::unique_ptr<impl> p;
+};
+
+class __attribute__((visibility("default"))) mcdma_channel {
+public:
+    mcdma_channel();
+    ~mcdma_channel();
+    mcdma_caps caps() const;
+    void connect(const mcdma_caps & peer);
+    std::unique_ptr<mcdma_region> register_span(const ggml_backend_dma_span & span, bool remote_write);
+    std::unique_ptr<mcdma_region> register_read_only_span(const ggml_backend_dma_span & span);
+    void transfer_at(mcdma_region & local, size_t local_offset, uint64_t remote_address, uint32_t remote_rkey, size_t bytes, bool write);
+    void transfer(mcdma_region & local, uint64_t remote_address, uint32_t remote_rkey, size_t bytes, bool write);
+    void stop();
+private:
+    std::unique_ptr<mcdma_region> register_flags(const ggml_backend_dma_span & span, int access);
+    struct impl;
+    std::unique_ptr<impl> p;
+};
